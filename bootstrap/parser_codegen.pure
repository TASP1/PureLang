// Self-host subset: parse "print <digits>" and emit minimal LLVM IR to stdout counts
// Full purec remains Rust; this proves parser + codegen pipeline in PureLang.

fn main() {
    src = "print 42"
    n = str_len(src)
    // expect: p r i n t space digits
    mut ok = 0
    if n >= 7 {
        if str_char_at(src, 0) == 112 {
            if str_char_at(src, 1) == 114 {
                if str_char_at(src, 2) == 105 {
                    if str_char_at(src, 3) == 110 {
                        if str_char_at(src, 4) == 116 {
                            if str_char_at(src, 5) == 32 {
                                ok = 1
                            }
                        }
                    }
                }
            }
        }
    }
    mut val = 0
    mut i = 6
    while i < n {
        mut c = str_char_at(src, i)
        if c >= 48 {
            if c <= 57 {
                val = val * 10 + (c - 48)
                i = i + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    // codegen result markers: ok flag, parsed number, IR line count (fixed template = 8)
    print ok
    print val
    print 8
}
