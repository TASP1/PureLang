// Bootstrap lexer seed: classify ASCII characters of a source string

fn main() {
    src = "fn add(a, b) { return a + b }"
    n = str_len(src)
    mut i = 0
    mut letters = 0
    mut digits = 0
    mut space = 0
    mut punct = 0
    while i < n {
        c = str_char_at(src, i)
        if c >= 65 {
            if c <= 90 {
                letters = letters + 1
            } else {
                if c >= 97 {
                    if c <= 122 {
                        letters = letters + 1
                    } else {
                        punct = punct + 1
                    }
                } else {
                    punct = punct + 1
                }
            }
        } else {
            if c >= 48 {
                if c <= 57 {
                    digits = digits + 1
                } else {
                    if c == 32 {
                        space = space + 1
                    } else {
                        punct = punct + 1
                    }
                }
            } else {
                if c == 32 {
                    space = space + 1
                } else {
                    punct = punct + 1
                }
            }
        }
        i = i + 1
    }
    print n
    print letters
    print digits
    print space
    print punct
}
