// Bootstrap: minimal character classifier over a source string
// (seed for a future PureLang-written lexer)

fn main() {
    src = "fn add(a, b) { return a + b }"
    n = str_len(src)
    print n
    // Count letters vs symbols (manual index loop)
    mut i = 0
    mut letters = 0
    mut others = 0
    while i < n {
        // str_get not available — approximate via length only in MVP bootstrap
        i = i + 1
    }
    print i
    print ui_native_available()
}
