                                                        if c <= 122 {
                                                            j = j + 1
                                                        } else {
                                                            if c >= 48 {
                                                                if c <= 57 {
                                                                    j = j + 1
                                                                } else {
                                                                    if c == 95 {
                                                                        j = j + 1
                                                                    } else {
                                                                        break
                                                                    }
                                                                }
                                                            } else {
                                                                if c == 95 {
                                                                    j = j + 1
                                                                } else {
                                                                    break
                                                                }
                                                            }
                                                        }
                                                    } else {
                                                        if c >= 65 {
                                                            if c <= 90 {
                                                                j = j + 1
                                                            } else {
                                                                break
                                                            }
                                                        } else {
                                                            break
                                                        }
                                                    }
                                                }
                                                pv = map_get(env, str_slice(src, pa, j))
                                            }
                                        } else {
                                            mut pa2 = j
                                            while j < body_end {
                                                c = str_char_at(src, j)
                                                if c >= 97 {
                                                    if c <= 122 {
                                                        j = j + 1
                                                    } else {
                                                        if c >= 48 {
                                                            if c <= 57 {
                                                                j = j + 1
                                                            } else {
                                                                if c == 95 {
                                                                    j = j + 1
                                                                } else {
                                                                    break
                                                                }
                                                            }
                                                        } else {
                                                            if c == 95 {
                                                                j = j + 1
                                                            } else {
                                                                break
                                                            }
                                                        }
                                                    }
                                                } else {
                                                    break
