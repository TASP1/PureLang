// PureLang subset compiler v0.37
// Supports multi-letter ids, assign, print expr (+), if, while (compile-time interpret)
// Source: bootstrap/samples/control.pure or add.pure

fn main() {
    mut src = "sum = 0\ni = 0\nwhile i < 5 {\n  sum = sum + i\n  i = i + 1\n}\nprint sum\n"
    mut from_file = 0
    f = read_file("bootstrap/samples/control.pure")
    if str_len(f) > 0 {
        src = f
        from_file = 1
    } else {
        f2 = read_file("bootstrap/samples/add.pure")
        if str_len(f2) > 0 {
            src = f2
            from_file = 1
        }
    }

    n = str_len(src)
    env = map_new()
    mut i = 0
    mut assigns = 0
    mut prints = 0
    mut loops = 0
    mut ifs = 0
    mut ir_body = ""

    while i < n {
        // skip ws
        mut c = 0
        while i < n {
            c = str_char_at(src, i)
            if c == 32 {
                i = i + 1
            } else {
                if c == 10 {
                    i = i + 1
                } else {
                    if c == 13 {
                        i = i + 1
                    } else {
                        if c == 9 {
                            i = i + 1
                        } else {
                            break
                        }
                    }
                }
            }
        }
        if i >= n {
            break
        }
        c = str_char_at(src, i)

        // while
        if c == 119 {
            if i + 5 <= n {
                if str_eq(str_slice(src, i, i + 5), "while") == 1 {
                    i = i + 5
                    while i < n {
                        c = str_char_at(src, i)
                        if c == 32 {
                            i = i + 1
                        } else {
                            break
                        }
                    }
                    // condition: ident op number  (ident < number)
                    mut ca = i
                    while i < n {
                        c = str_char_at(src, i)
                        if c >= 97 {
                            if c <= 122 {
                                i = i + 1
                            } else {
                                if c >= 65 {
                                    if c <= 90 {
                                        i = i + 1
                                    } else {
                                        if c >= 48 {
                                            if c <= 57 {
                                                i = i + 1
                                            } else {
                                                if c == 95 {
                                                    i = i + 1
                                                } else {
                                                    break
                                                }
                                            }
                                        } else {
                                            if c == 95 {
                                                i = i + 1
                                            } else {
                                                break
                                            }
                                        }
                                    }
                                } else {
                                    if c >= 48 {
                                        if c <= 57 {
