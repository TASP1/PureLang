                            i = i + 1
                        }
                    }
                    mut body_start = i
                    mut depth = 1
                    while i < n {
                        if depth == 0 {
                            break
                        }
                        c = str_char_at(src, i)
                        if c == 123 {
                            depth = depth + 1
                        } else {
                            if c == 125 {
                                depth = depth - 1
                            }
                        }
                        if depth > 0 {
                            i = i + 1
                        }
                    }
                    mut body_end = i
                    if i < n {
                        if str_char_at(src, i) == 125 {
                            i = i + 1
                        }
                    }
                    // interpret while at compile time (max 1000 iters)
                    mut guard = 0
                    while guard < 1000 {
                        mut lv = map_get(env, cname)
                        mut ok = 0
                        if op == 1 {
                            if lv < cnum {
                                ok = 1
                            }
                        } else {
                            if op == 2 {
                                if lv < cnum {
                                    ok = 1
                                } else {
                                    if lv == cnum {
