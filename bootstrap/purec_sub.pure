                                        } else {
                                            if c == 95 {
                                                i = i + 1
                                            } else {
                                                break
                                            }
                                        }
                                    } else {
                                        if c == 95 {
                                            i = i + 1
                                        } else {
                                            break
                                        }
                                    }
                                }
                            }
                        } else {
                            if c >= 65 {
                                if c <= 90 {
                                    i = i + 1
                                } else {
                                    break
                                }
                            } else {
                                break
                            }
                        }
                    }
                    mut cname = str_slice(src, ca, i)
                    while i < n {
                        c = str_char_at(src, i)
                        if c == 32 {
                            i = i + 1
                        } else {
                            break
                        }
                    }
                    mut op = 0
                    if i < n {
                        c = str_char_at(src, i)
                        if c == 60 {
                            op = 1
                            i = i + 1
                            if i < n {
                                if str_char_at(src, i) == 61 {
                                    op = 2
                                    i = i + 1
                                }
                            }
                        } else {
                            if c == 62 {
                                op = 3
                                i = i + 1
                                if i < n {
                                    if str_char_at(src, i) == 61 {
                                        op = 4
                                        i = i + 1
                                    }
                                }
                            } else {
                                if c == 61 {
                                    if i + 1 < n {
                                        if str_char_at(src, i + 1) == 61 {
                                            op = 5
                                            i = i + 2
                                        }
                                    }
                                }
                            }
                        }
                    }
                    while i < n {
                        c = str_char_at(src, i)
                        if c == 32 {
                            i = i + 1
                        } else {
                            break
                        }
                    }
                    mut cnum = 0
                    while i < n {
                        c = str_char_at(src, i)
                        if c >= 48 {
                            if c <= 57 {
                                cnum = cnum * 10 + (c - 48)
                                i = i + 1
                            } else {
                                break
                            }
                        } else {
                            break
                        }
                    }
                    while i < n {
