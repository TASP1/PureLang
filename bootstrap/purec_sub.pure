                                            }
                                            pv = map_get(env, str_slice(src, pa2, j))
                                        }
                                        ir_body = str_concat(ir_body, "  call i32 (ptr, ...) @printf(ptr %f, i64 ")
                                        ir_body = str_concat(ir_body, str_from_num(pv))
                                        ir_body = str_concat(ir_body, ")\n")
                                        prints = prints + 1
