// PureLang mini-compiler: parse `print <int>`, emit real LLVM IR, write file

fn main() {
    src = "print 42"
    n = str_len(src)
    mut ok = 0
    if n >= 7 {
        if str_char_at(src, 0) == 112 {
            if str_char_at(src, 5) == 32 {
                ok = 1
            }
        }
    }
    mut val = 0
    mut i = 6
    while i < n {
        mut c = str_char_at(src, i)
        if c >= 48 {
            if c <= 57 {
                val = val * 10 + (c - 48)
                i = i + 1
            } else {
                break
            }
        } else {
            break
        }
    }

    mut ir = "target triple = \"x86_64-unknown-linux-gnu\"\n"
    ir = str_concat(ir, "declare i32 @printf(ptr, ...)\n")
    ir = str_concat(ir, "@.fmt = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"\n")
    ir = str_concat(ir, "define i32 @main() {\n")
    ir = str_concat(ir, "entry:\n")
    ir = str_concat(ir, "  %f = getelementptr inbounds [6 x i8], ptr @.fmt, i64 0, i64 0\n")
    ir = str_concat(ir, "  call i32 (ptr, ...) @printf(ptr %f, i64 ")
    ir = str_concat(ir, str_from_num(val))
    ir = str_concat(ir, ")\n")
    ir = str_concat(ir, "  ret i32 0\n")
    ir = str_concat(ir, "}\n")
    write_file("bootstrap_out.ll", ir)

    print ok
    print val
    print str_len(ir)
}
